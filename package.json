{
  "name": "discord-faceit-hub-bot",
  "version": "1.0.0",
  "description": "Discord bot integrated with Faceit Hub webhooks to announce matches.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix web_panel_src install --include=dev && npm --prefix web_panel_src run build && npm --prefix admin_panel_src install --include=dev && npm --prefix admin_panel_src run build",
    "start": "node index.js",
    "test:webhook": "node test-webhook.js",
    "lint": "npm --prefix admin_panel_src run lint"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^12.1.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "msedge-tts": "^2.0.7",
    "play-dl": "^1.9.7",
    "socket.io-client": "^4.8.4",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0",
    "ws": "^8.21.0",
    "youtube-po-token-generator": "^0.6.0",
    "youtubei.js": "^17.2.0"
  }
}
